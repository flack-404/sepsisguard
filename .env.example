# SepsisGuard environment template — copy to .env and fill in.

# Required: Anthropic API key for Claude tool calls (tools 2, 4, 6).
ANTHROPIC_API_KEY=sk-ant-...

# Default Claude model. Spec mandates claude-opus-4-7; do NOT pass `temperature`.
ANTHROPIC_MODEL=claude-opus-4-7

# Server transport. Auto-selects "sse" when $PORT is set (Railway).
# Local dev override: stdio | sse | http
SEPSISGUARD_TRANSPORT=stdio

# Logging
LOG_LEVEL=INFO

# Demo mode toggles in-process FHIR mock and stub Claude calls when no API key.
DEMO_MODE=false
